#		gsub(/""/, "\"", $i);   # Replace escaped double quotes with single quotes
#	    }
#	    print $0;  # Print the whole record
#	}' "$selected_source_file"

	awk -v FPAT='([^,]*)|("[^"]+")' '{
	    for (i = 1; i <= NF; i++) {
		# Remove leading and trailing quotes from each field
		gsub(/^"|"$/, "", $i);
		# Replace escaped double quotes with a single quote
		gsub(/""/, "\"", $i);
	    }
	    # Print the fields without quotes, separated by a space or other delimiter
	    print $1, $2, $3
	}' "$selected_source_file"

}

# Main function
main() {
    local selection=$(display_sources_for_selection | fzf --ansi --preview-window=hidden:wrap)
    local selected_file=$(echo "$selection" | awk '{print $NF}')

    if [ -n "$selected_file" ]; then
        load_and_present_data "$selected_file"
    fi
}

# Execute main if script is not being sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
