            # Remove leading and trailing quotes from each field
#            gsub(/^"|"$/, "", $i);
#            # Replace escaped quotes with a single quote
#            gsub(/""/, "\"", $i);
#        }
#        # Print all fields, separated by a comma
#        $1 = $1; # This forces awk to re-construct the record with the new field separators
#        print
#    }' "$selected_source_file" | column -t -s ',' | fzf --ansi --preview-window=hidden:wrap

